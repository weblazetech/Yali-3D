---
import type { TimelineMilestone } from '../data/types';

interface Props {
  milestones: TimelineMilestone[];
}

const { milestones } = Astro.props;
---

{
  milestones.length > 0 && (
    <div class="timeline" data-timeline>
      <ol class="timeline__list" data-timeline-list>
        {milestones.map((milestone, index) => (
          <li role="presentation">
            <button
              type="button"
              class="timeline__button"
              id={`timeline-tab-${index}`}
              aria-controls={`timeline-panel-${index}`}
              aria-selected={index === 0 ? 'true' : 'false'}
              tabindex={index === 0 ? 0 : -1}
              data-timeline-button
            >
              <span class="timeline__year">{milestone.year}</span>
              <span class="timeline__title">{milestone.title}</span>
            </button>
          </li>
        ))}
      </ol>
      <div>
        {milestones.map((milestone, index) => (
          <section
            class="timeline__panel"
            id={`timeline-panel-${index}`}
            aria-label={milestone.title}
            data-timeline-panel
          >
            <h3>{milestone.title}</h3>
            <p>{milestone.description}</p>
          </section>
        ))}
      </div>
    </div>
  )
}

<script>
  document.querySelectorAll<HTMLElement>('[data-timeline]').forEach((root) => {
    const list = root.querySelector<HTMLElement>('[data-timeline-list]');
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-timeline-button]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-timeline-panel]'));
    if (!list || buttons.length === 0 || buttons.length !== panels.length) return;

    list.setAttribute('role', 'tablist');
    list.setAttribute('aria-orientation', 'vertical');
    root.dataset.enhanced = 'true';

    buttons.forEach((button, index) => {
      const panel = panels[index];
      if (!panel) return;
      button.setAttribute('role', 'tab');
      button.setAttribute('aria-controls', panel.id);
      panel.setAttribute('role', 'tabpanel');
      panel.setAttribute('aria-labelledby', button.id);
      panel.setAttribute('tabindex', '0');
    });

    const select = (index: number, moveFocus = false): void => {
      buttons.forEach((button, buttonIndex) => {
        const selected = buttonIndex === index;
        button.setAttribute('aria-selected', String(selected));
        button.tabIndex = selected ? 0 : -1;
        const panel = panels[buttonIndex];
        if (panel) panel.hidden = !selected;
      });
      if (moveFocus) buttons[index]?.focus();
    };

    buttons.forEach((button, index) => {
      button.addEventListener('click', () => select(index));
    });

    list.addEventListener('keydown', (event) => {
      const current = buttons.indexOf(document.activeElement as HTMLButtonElement);
      if (current === -1) return;
      let next = current;
      if (event.key === 'ArrowDown' || event.key === 'ArrowRight') next = (current + 1) % buttons.length;
      else if (event.key === 'ArrowUp' || event.key === 'ArrowLeft')
        next = (current - 1 + buttons.length) % buttons.length;
      else if (event.key === 'Home') next = 0;
      else if (event.key === 'End') next = buttons.length - 1;
      else return;
      event.preventDefault();
      select(next, true);
    });

    select(0);
  });
</script>
