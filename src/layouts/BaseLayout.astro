---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { clinic } from '../data/site';

interface Props {
  /** Route-specific page title. The clinic name is appended. */
  title?: string;
  description: string;
  noindex?: boolean;
}

const {
  title,
  description,
  noindex = false,
} = Astro.props;

// Vercel injects this system variable during a Vercel build. Keeping both
// observability components out of other builds avoids requesting Vercel-only
// endpoints on hosts that cannot serve them.
const vercelObservabilityEnabled = import.meta.env.VERCEL === '1';

const pageTitle = title
  ? `${title} | ${clinic.name}`
  : `${clinic.name} | Thoughtful dental care in Hyderabad`;

const siteOrigin = Astro.site?.origin ?? null;
const canonical = siteOrigin ? new URL(Astro.url.pathname, siteOrigin).href : null;
const ogImage = siteOrigin ? new URL('/images/yali-crest-640.png', siteOrigin).href : null;

const organisationLd = siteOrigin
  ? {
      '@context': 'https://schema.org',
      '@type': 'Organization',
      name: clinic.name,
      slogan: clinic.tagline,
      url: siteOrigin,
      logo: ogImage,
      areaServed: 'Hyderabad, India',
    }
  : null;
---

<!doctype html>
<html lang="en-IN" data-motion="full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {canonical && <link rel="canonical" href={canonical} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={clinic.name} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#ECE4D9" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/images/yali-crest-128.png" />
    <link rel="preload" href="/fonts/lora-latin.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href="/fonts/dm-sans-latin.woff2" as="font" type="font/woff2" crossorigin="anonymous" />

    {organisationLd && (
      <script type="application/ld+json" set:html={JSON.stringify(organisationLd)} />
    )}

    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.dataset.js = 'true';
        var prefersReduced = false;
        try {
          prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        } catch (error) {
          prefersReduced = false;
        }
        var stored = null;
        try {
          stored = window.localStorage.getItem('yali-motion');
        } catch (error) {
          stored = null;
        }
        var reduced = stored === 'reduced' ? true : stored === 'full' ? false : prefersReduced;
        root.dataset.motion = reduced ? 'reduced' : 'full';
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/ui';
    </script>
    {vercelObservabilityEnabled && <Analytics />}
    {vercelObservabilityEnabled && <SpeedInsights />}
  </body>
</html>
